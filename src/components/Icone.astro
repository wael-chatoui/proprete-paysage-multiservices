---
// Icônes d'action, tracées à la main pour rester légères.
interface Props {
  nom: 'tel' | 'sms' | 'mail';
}
const { nom } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nom === 'tel' && <path d="M5 3h3.5l1.8 4.6-2.3 1.6a12 12 0 0 0 6.8 6.8l1.6-2.3L21 15.5V19a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z" />}
  {nom === 'sms' && <path d="M4 5h16v11H9l-5 4z" />}
  {nom === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
</svg>
