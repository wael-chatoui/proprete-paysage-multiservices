---
// Affiche une image du manifeste (src/data/photos.ts), ou un emplacement tant qu'elle manque.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../data/photos';

interface Props {
  nom: string;
  sizes: string;
  prioritaire?: boolean;
  ratio?: string;
  legende?: boolean;
  class?: string;
}
const { nom, sizes, prioritaire = false, ratio = '4 / 5', legende = true, class: classe } = Astro.props;
const photo = photos[nom];
const fichiers = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const candidats = photo?.fichier ? [photo.fichier] : ['jpg', 'jpeg', 'webp', 'png', 'avif'].map((ext) => `${nom}.${ext}`);
const image = candidats.map((f) => fichiers[`../assets/photos/${f}`]?.default).find(Boolean);
const mention = photo?.type === 'reel' ? null : photo?.type === 'ia' ? 'Illustration générée par IA' : 'Illustration';
---
{(image || prioritaire) && (
<figure class:list={['photo', classe]} style={`--ratio:${ratio}`}>
  {image ? (
    <Picture
      src={image}
      alt={photo.alt}
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1280, 1600].filter((w) => w <= image.width)}
      sizes={sizes}
      loading={prioritaire ? 'eager' : 'lazy'}
      fetchpriority={prioritaire ? 'high' : 'auto'}
      decoding="async"
    />
  ) : (
    <div class="photo-attente" aria-hidden="true"></div>
  )}
  {image && legende && (mention || photo?.credit) && (
    <figcaption>
      {mention}{photo?.credit && <>. {photo.credit}{photo.licence && <>, <a href={photo.licence.url} rel="license noopener">{photo.licence.nom}</a></>}</>}
    </figcaption>
  )}
</figure>
)}

<style>
  .photo {
    margin: 0;
  }
  .photo :global(img),
  .photo-attente {
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    border-radius: var(--rayon);
    background: var(--pin-clair);
  }
  .photo-attente {
    background:
      repeating-linear-gradient(90deg, transparent 0 22px, rgb(0 0 0 / 0.08) 22px 30px),
      linear-gradient(var(--pin-clair), var(--pin));
  }
  figcaption {
    margin-top: var(--s-2);
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--texte-doux);
  }
</style>
