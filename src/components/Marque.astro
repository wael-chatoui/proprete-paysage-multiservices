---
// Marque : coupe de tronc (cernes) et trait de peinture de marquage forestier.
interface Props {
  taille?: number;
  clair?: boolean;
}
const { taille = 40, clair = false } = Astro.props;
const trait = clair ? '#ffffff' : '#1e3a2b';
---
<svg class="marque" width={taille} height={taille} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <g fill="none" stroke={trait} stroke-linecap="round">
    <path stroke-width="3" d="M24 3.5c11.6-.3 20.8 9 20.5 20.6-.2 11.2-9.3 20.4-20.6 20.4C12.4 44.6 3.4 35.4 3.5 24 3.6 12.9 12.7 3.8 24 3.5z" />
    <path stroke-width="2" d="M24 10.5c7.6-.1 13.6 6 13.5 13.6-.1 7.3-6.2 13.4-13.6 13.4-7.5.1-13.5-6-13.4-13.5.1-7.3 6.1-13.4 13.5-13.5z" />
    <path stroke-width="2" d="M24.2 17c3.9 0 7 3.1 6.9 7.1-.1 3.8-3.1 6.9-7 6.9-3.9.1-7-3.1-7-7 0-3.8 3.2-7 7.1-7z" />
    <circle cx="24" cy="24" r="1.6" fill={trait} stroke="none" />
  </g>
  <path fill="#ff2e7e" d="M29.5 9.6c3.8-1.6 8-2.2 12.1-1.7 1.2.2 1.4 1.8.3 2.3-3.9 1.7-8 2.8-12.2 3.3-1.6.2-2.5-2.9-.2-3.9z" />
</svg>
