---
import type { Miette } from '../lib/schema';
interface Props {
  miettes: Miette[];
  clair?: boolean;
}
const { miettes, clair = false } = Astro.props;
---
<nav class:list={['ariane', { clair }]} aria-label="Fil d'Ariane">
  <ol>
    {miettes.map((m, i) => (
      <li>
        {i < miettes.length - 1 ? <a href={m.chemin}>{m.nom}</a> : <span aria-current="page">{m.nom}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .ariane ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    font-size: var(--t--1);
    color: var(--texte-doux);
  }
  .ariane li + li::before {
    content: '/';
    margin-right: var(--s-2);
    opacity: 0.6;
  }
  .ariane.clair ol {
    color: rgb(255 255 255 / 0.8);
  }
</style>
