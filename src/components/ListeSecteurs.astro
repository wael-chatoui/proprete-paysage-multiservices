---
import type { CollectionEntry } from 'astro:content';
import { fourchetteKm } from '../lib/contenu';
interface Props {
  secteurs: CollectionEntry<'secteurs'>[];
  actif?: string;
  afficherCommunes?: boolean;
}
const { secteurs, actif, afficherCommunes = true } = Astro.props;
---
<ul class="secteurs">
  {secteurs.map((s) => {
    const { min, max } = fourchetteKm(s.data.communes);
    const nomsCommunes = s.data.communes.map((c) => c.nom);
    return (
      <li>
        <a href={`/secteurs/${s.id}/`} class="secteur-lien" aria-current={s.id === actif ? 'page' : undefined}>
          <span class="secteur-entete">
            <span class="secteur-nom">{s.data.nom}</span>
            <span class="secteur-km">{min} à {max} km</span>
          </span>
          {afficherCommunes && (
            <span class="secteur-villes">
              {nomsCommunes.join(' · ')}
            </span>
          )}
        </a>
      </li>
    );
  })}
</ul>

<style>
  .secteurs {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--pin);
  }
  .secteurs li {
    border-bottom: 1px solid var(--filet);
  }
  .secteur-lien {
    display: block;
    padding-block: var(--s-3);
    text-decoration: none;
  }
  .secteur-entete {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
  }
  .secteur-nom {
    font-family: var(--f-titre);
    font-stretch: 82%;
    font-weight: 700;
    font-size: var(--t-1);
    line-height: 1.2;
    color: var(--texte);
  }
  .secteur-lien:hover .secteur-nom {
    text-decoration: underline;
  }
  .secteur-lien[aria-current='page'] .secteur-nom {
    background: var(--trait) no-repeat 0 100% / 100% 0.25em;
  }
  .secteur-km {
    flex: none;
    font-size: var(--t--1);
    color: var(--texte-doux);
    font-variant-numeric: tabular-nums;
  }
  .secteur-villes {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--texte-doux);
  }
</style>
