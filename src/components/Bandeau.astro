---
// En-tête des pages intérieures : fil d'Ariane, H1, réponse directe et date de mise à jour.
import Ariane from './Ariane.astro';
import type { Miette } from '../lib/schema';
import { dateFr } from '../lib/contenu';
interface Props {
  h1: string;
  accroche?: string;
  miettes: Miette[];
  dateModified?: string;
}
const { h1, accroche, miettes, dateModified } = Astro.props;
---
<section class="bandeau">
  <div class="enveloppe">
    <Ariane miettes={[{ nom: 'Accueil', chemin: '/' }, ...miettes]} clair />
    <h1>{h1}</h1>
    {accroche && <p class="bandeau-accroche">{accroche}</p>}
    <slot />
    {dateModified && <p class="bandeau-date">Mis à jour le <time datetime={dateModified}>{dateFr(dateModified)}</time></p>}
  </div>
</section>

<style>
  .bandeau {
    background: var(--pin);
    color: var(--papier);
    padding-block: var(--s-6) var(--s-7);
  }
  .bandeau h1 {
    margin-top: var(--s-5);
    max-width: 22ch;
    font-size: var(--t-4);
  }
  .bandeau-accroche {
    margin-top: var(--s-5);
    max-width: 58ch;
    font-size: var(--t-1);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }
  .bandeau-date {
    margin-top: var(--s-5);
    font-size: var(--t--1);
    color: rgb(255 255 255 / 0.7);
  }
</style>
