---
// En-tête des pages intérieures : fil d'Ariane, H1, réponse directe, photo immersive optionnelle et date de mise à jour.
import Ariane from './Ariane.astro';
import Photo from './Photo.astro';
import type { Miette } from '../lib/schema';
import { dateFr } from '../lib/contenu';

interface Props {
  h1: string;
  accroche?: string;
  miettes: Miette[];
  dateModified?: string;
  photo?: string;
}
const { h1, accroche, miettes, dateModified, photo } = Astro.props;
const aPhoto = Boolean(photo) || Astro.slots.has('photo');
---
<section class:list={['bandeau', { 'bandeau-avec-photo': aPhoto }]}>
  <div class="enveloppe bandeau-conteneur">
    <div class="bandeau-texte">
      <Ariane miettes={[{ nom: 'Accueil', chemin: '/' }, ...miettes]} clair />
      <h1>{h1}</h1>
      {accroche && <p class="bandeau-accroche">{accroche}</p>}
      <slot />
      {dateModified && <p class="bandeau-date">Mis à jour le <time datetime={dateModified}>{dateFr(dateModified)}</time></p>}
    </div>

    {aPhoto && (
      <div class="bandeau-media">
        {photo ? (
          <Photo
            nom={photo}
            sizes="(max-width: 56rem) 100vw, 42vw"
            ratio="16 / 10"
            prioritaire
            class="bandeau-photo"
          />
        ) : (
          <slot name="photo" />
        )}
      </div>
    )}
  </div>
</section>

<style>
  .bandeau {
    background: var(--pin);
    color: var(--papier);
    padding-block: var(--s-6) var(--s-7);
  }
  .bandeau-conteneur {
    display: block;
  }
  .bandeau-avec-photo .bandeau-conteneur {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--s-6) var(--s-7);
    align-items: center;
  }
  .bandeau-texte {
    min-width: 0;
  }
  .bandeau h1 {
    margin-top: var(--s-5);
    max-width: 24ch;
    font-size: var(--t-4);
  }
  .bandeau-accroche {
    margin-top: var(--s-5);
    max-width: 58ch;
    font-size: var(--t-1);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }
  .bandeau-date {
    margin-top: var(--s-5);
    font-size: var(--t--1);
    color: rgb(255 255 255 / 0.7);
  }
  .bandeau-media {
    min-width: 0;
  }
  .bandeau-media :global(.photo img) {
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.28);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .bandeau-media :global(figcaption) {
    color: rgb(255 255 255 / 0.7);
  }
  @media (max-width: 56rem) {
    .bandeau-avec-photo .bandeau-conteneur {
      grid-template-columns: 1fr;
    }
    .bandeau-media {
      margin-top: var(--s-2);
    }
  }
</style>
