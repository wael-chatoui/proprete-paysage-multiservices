---
// Encart de contact des pages intérieures : appel direct prioritaire, SMS et e-mail.
import Icone from './Icone.astro';
import { business, telHref, smsDevis, mailtoDevis } from '../data/business';

interface Props {
  prestation?: string;
  titre?: string;
}
const { prestation, titre = 'Un devis pour votre chantier' } = Astro.props;
---
<aside class="encart" aria-labelledby="encart-titre">
  <h2 id="encart-titre">{titre}</h2>
  <a class="encart-numero" href={telHref}>
    <span class="visuellement-cache">Appeler le </span>{business.telephone.affichage}
  </a>

  <a class="action btn-primaire encart-appel" href={telHref}>
    <Icone nom="tel" />
    <span>Appeler le {business.telephone.affichage}</span>
  </a>

  <p class="encart-legende">Ou envoyez des photos avec la commune et l'accès :</p>
  <div class="encart-actions">
    <a class="action btn-secondaire" href={smsDevis(prestation)}>
      <Icone nom="sms" />
      <span>Envoyer des photos par SMS</span>
    </a>
    <a class="action btn-tertiaire" href={mailtoDevis(prestation)}>
      <Icone nom="mail" />
      <span>Écrire un e-mail</span>
    </a>
  </div>
</aside>

<style>
  .encart {
    border: 2px solid var(--pin);
    border-radius: var(--rayon);
    padding: var(--s-5);
    background: var(--papier);
  }
  .encart h2 {
    font-size: var(--t-1);
    font-stretch: 82%;
  }
  .encart-numero {
    display: inline-block;
    margin-top: var(--s-3);
    font-family: var(--f-titre);
    font-stretch: var(--large-chiffre);
    font-weight: 850;
    font-size: var(--t-3);
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    padding-bottom: 0.12em;
    background: var(--trait) no-repeat 0 100% / 100% 0.2em;
    color: var(--texte);
  }
  .encart-numero:hover,
  .encart-numero:focus-visible {
    background-size: 100% 0.32em;
  }
  .encart-appel {
    width: 100%;
    margin-top: var(--s-4);
    font-size: 1rem;
    padding-inline: var(--s-3);
    justify-content: center;
  }
  .encart p.encart-legende {
    margin-top: var(--s-4);
    font-size: var(--t--1);
    color: var(--texte-doux);
    line-height: 1.45;
  }
  .encart-actions {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .encart-actions .action {
    width: 100%;
    justify-content: center;
    font-size: 0.95rem;
  }
  .encart-actions .btn-secondaire {
    border-color: var(--pin);
    color: var(--pin-profond);
  }
  .encart-actions .btn-secondaire:hover {
    background: rgba(18, 36, 27, 0.06);
  }
  .encart-actions .btn-tertiaire {
    color: var(--pin-profond);
  }
</style>
