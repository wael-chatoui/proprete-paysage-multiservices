---
// Barre d'actions fixée en bas de l'écran sur mobile : appel en orange signalisation, SMS et e-mail en vert pin sobre.
import Icone from './Icone.astro';
import { telHref, smsDevis, mailtoDevis } from '../data/business';

interface Props {
  prestation?: string;
}
const { prestation } = Astro.props;
---
<nav class="barre-appel" aria-label="Nous contacter">
  <a class="barre-action-principale" href={telHref}>
    <Icone nom="tel" />
    <span>Appeler</span>
  </a>
  <a class="barre-action-secondaire" href={smsDevis(prestation)}>
    <Icone nom="sms" />
    <span>SMS</span>
  </a>
  <a class="barre-action-secondaire" href={mailtoDevis(prestation)}>
    <Icone nom="mail" />
    <span>E-mail</span>
  </a>
</nav>

<style>
  .barre-appel {
    display: none;
  }
  @media (max-width: 52rem) {
    .barre-appel {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 30;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      background: var(--pin-profond);
      padding-bottom: env(safe-area-inset-bottom);
      box-shadow: 0 -2px 12px rgb(0 0 0 / 0.2);
    }
    .barre-appel a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--s-2);
      min-height: 3.5rem;
      text-decoration: none;
      font-family: var(--f-titre);
      font-stretch: 85%;
      font-weight: 700;
      font-size: 1.05rem;
      transition: background-color 0.15s ease;
    }
    .barre-action-principale {
      background: var(--orange-signal);
      color: #ffffff;
    }
    .barre-action-principale:hover,
    .barre-action-principale:active {
      background: var(--orange-signal-survol);
    }
    .barre-action-secondaire {
      background: var(--pin-profond);
      color: #ffffff;
    }
    .barre-action-secondaire:hover,
    .barre-action-secondaire:active {
      background: var(--pin);
    }
    .barre-action-secondaire + .barre-action-secondaire {
      border-left: 1px solid rgb(255 255 255 / 0.18);
    }
    .barre-appel :global(svg) {
      width: 1.2em;
      height: 1.2em;
      flex: none;
    }
    :global(body) {
      padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
