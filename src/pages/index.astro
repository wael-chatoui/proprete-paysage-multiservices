---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icone from '../components/Icone.astro';
import CarteCernes from '../components/CarteCernes.astro';
import Faq from '../components/Faq.astro';
import ListePrestations from '../components/ListePrestations.astro';
import ListeSecteurs from '../components/ListeSecteurs.astro';
import { business, ENTITE, telHref, smsDevis, mailtoDevis } from '../data/business';
import { prestations, secteurs, guides, fourchetteKm } from '../lib/contenu';
import { noeudFaq } from '../lib/schema';

const listePrestations = await prestations();
const listeSecteurs = await secteurs();
const listeGuides = (await guides()).slice(0, 3);

const pointsCarte = listeSecteurs.map((s) => ({
  slug: s.id,
  nom: s.data.nom,
  centre: s.data.centre,
  ...(({ min, max }) => ({ kmMin: min, kmMax: max }))(fourchetteKm(s.data.communes)),
}));

const faq = [
  { q: `Qui est ${business.nom} ?`, r: ENTITE },
  {
    q: 'Comment obtenir un devis ?',
    r: `Appelez le ${business.telephone.affichage}, ou envoyez par SMS ou par e-mail (${business.email}) quelques photos des arbres ou du terrain, la commune et les conditions d'accès. Il n'y a pas de formulaire en ligne.`,
  },
  {
    q: 'Dans quelles communes intervenez-vous ?',
    r: "Dans les Landes et les départements voisins, depuis Louer : Dax, Tartas, Mont-de-Marsan, Saint-Sever, Hagetmau, la côte sud (Capbreton, Hossegor, Seignosse), le Marensin, la Haute-Lande, le Pays d'Orthe, le Béarn des Gaves (Orthez, Salies-de-Béarn) et le Pays basque intérieur.",
  },
  {
    q: 'Faut-il débroussailler autour de sa maison dans les Landes ?',
    r: "Oui, si la maison est à moins de 200 m de bois, forêts ou landes de plus de 0,5 ha : le propriétaire doit débroussailler sur 50 m autour d'elle et sur 6 m de part et d'autre de sa voie privée d'accès, selon l'arrêté préfectoral des Landes du 22 août 2025. Depuis février 2026, les jardins clos ne sont plus exemptés.",
  },
  {
    q: 'Quelles prestations proposez-vous ?',
    r: "Deux volets d'activité : les travaux forestiers et d'arbres (abattage, élagage, débardage, débroussaillage OLD) et la propreté extérieure (remise en état et nettoyage de terrains en friche, entretien d'espaces verts).",
  },
  {
    q: 'Proposez-vous le nettoyage complet d’un terrain en friche ?',
    r: 'Oui. Nous remettons en état les parcelles extérieures : fauchage des ronces et broussailles, dégagement des accès et clôtures, ramassage des branchages et évacuation des déchets végétaux.',
  },
];

const titre = 'Abattage, élagage et nettoyage de terrain dans les Landes';
const description =
  "Abattage, élagage, débroussaillage OLD et nettoyage de terrains depuis Louer, entre Dax et Mont-de-Marsan. Appel ou SMS : 06 85 57 06 75.";
---
<Base titre={titre} description={description} noeuds={[noeudFaq('/', faq)]}>
  <section class="ouverture" aria-labelledby="titre-page">
    <div class="enveloppe ouverture-grille">
      <div class="ouverture-texte">
        <h1 id="titre-page">Abattage, élagage, débroussaillage et nettoyage de terrains dans les Landes</h1>
        <p class="ouverture-entite">{business.nom} travaille depuis Louer, au cœur des Landes. Un pin menaçant à abattre, une parcelle à débroussailler avant l'été (OLD), ou un terrain en friche à remettre en propreté avant une vente : décrivez-nous la situation.</p>

        <div class="ouverture-appel">
          <div class="numero-bloc">
            <a class="numero" href={telHref}>
              <span class="visuellement-cache">Appeler le </span>{business.telephone.affichage}
            </a>
            <svg class="numero-trait-svg trait-anime" viewBox="0 0 400 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path class="tracer-trait" pathLength="100" d="M 4 8 C 70 5, 140 11, 200 8 C 270 5, 340 10, 396 8" fill="none" stroke="var(--marquage)" stroke-width="7" stroke-linecap="round" />
            </svg>
          </div>

          <div class="ouverture-actions">
            <a class="action btn-primaire" href={telHref}>
              <Icone nom="tel" />
              <span>Appeler le {business.telephone.affichage}</span>
            </a>
            <a class="action btn-secondaire" href={smsDevis()}>
              <Icone nom="sms" />
              <span>Envoyer des photos par SMS</span>
            </a>
            <a class="action btn-tertiaire" href={mailtoDevis()}>
              <Icone nom="mail" />
              <span>Écrire un e-mail</span>
            </a>
          </div>
        </div>
      </div>
      <Photo nom="accueil" sizes="(max-width: 52rem) 100vw, 42vw" prioritaire ratio="16 / 10" class="ouverture-photo" />
    </div>
  </section>

  <section class="bloc" aria-labelledby="titre-prestations">
    <div class="enveloppe">
      <div class="bloc-titre">
        <h2 id="titre-prestations">Ce que nous faisons</h2>
        <p>Deux volets complémentaires : 4 métiers du bois et de la forêt, et 2 métiers de propreté extérieure.</p>
      </div>
      <ListePrestations prestations={listePrestations} poleNiveau="h3" titreNiveau="h4" poles={true} />

      <div class="focus-nettoyage">
        <div class="focus-nettoyage-texte">
          <span class="focus-badge">Zoom sur la propreté extérieure</span>
          <h3>Remise en état et nettoyage de parcelles</h3>
          <p>
            Avant une vente immobilière, après des travaux ou des intempéries, ou pour répondre à une obligation d'entretien : nous dégageons les ronces, libérons les clôtures et accès, ramassons les branchages et évacuons les déchets verts.
          </p>
          <a class="action btn-secondaire focus-lien" href="/nettoyage-proprete/">
            <span>Consulter la prestation nettoyage de terrain</span>
          </a>
        </div>
        <div class="focus-nettoyage-photo">
          <Photo nom="nettoyage-proprete" ratio="16 / 10" sizes="(max-width: 52rem) 100vw, 32vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="bloc deroule" aria-labelledby="titre-deroule">
    <div class="enveloppe">
      <div class="bloc-titre">
        <h2 id="titre-deroule">Comment se passe une demande de devis ?</h2>
      </div>
      <ol class="etapes">
        <li>
          <h3>Vous appelez ou vous écrivez</h3>
          <p>Par téléphone, SMS ou e-mail. Des photos aident beaucoup : l'arbre à traiter, la surface du terrain, les accès et ce qui l'entoure.</p>
        </li>
        <li>
          <h3>Vous précisez le chantier</h3>
          <p>La commune, la nature des travaux (arbres, débroussaillage ou nettoyage de friche), les dimensions approximatives et l'accès pour le matériel.</p>
        </li>
        <li>
          <h3>Vous recevez un devis écrit</h3>
          <p>Après un passage sur place si la situation l'exige. Le devis détaille le travail et précise ce que deviennent le bois, les végétaux et les déchets verts.</p>
        </li>
        <li>
          <h3>Le chantier est réalisé</h3>
          <p>À la date convenue ensemble, en veillant à la sécurité, à la saison et aux règles en vigueur.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="bloc" aria-labelledby="titre-zone">
    <div class="enveloppe zone-grille">
      <div>
        <div class="bloc-titre">
          <h2 id="titre-zone">Où intervenons-nous ?</h2>
          <p>Dans les Landes et les départements voisins, depuis Louer : de la côte sud au Bas-Armagnac, de la Haute-Lande au Béarn et au Pays basque intérieur.</p>
        </div>
        <ListeSecteurs secteurs={listeSecteurs} />
      </div>
      <CarteCernes secteurs={pointsCarte} id="carte-accueil" />
    </div>
  </section>

  {listeGuides.length > 0 && (
    <section class="bloc" aria-labelledby="titre-guides">
      <div class="enveloppe">
        <div class="bloc-titre">
          <h2 id="titre-guides">Les règles à connaître avant de couper</h2>
          <p>Débroussaillement obligatoire, arbres du voisin, période de nidification : des guides sourcés sur les textes officiels.</p>
        </div>
        <ul class="guides">
          {listeGuides.map((g) => (
            <li>
              <h3><a href={`/guides/${g.id}/`}>{g.data.nom}</a></h3>
              <p>{g.data.resume}</p>
            </li>
          ))}
        </ul>
        <p class="guides-tous"><a href="/guides/">Tous les guides</a></p>
      </div>
    </section>
  )}

  <div class="enveloppe bloc faq-accueil">
    <Faq faq={faq} />
    <p class="faq-lien-legal">
      Informations administratives, SIRET et immatriculation consultables sur la page <a href="/mentions-legales/">mentions légales</a> et la page <a href="/entreprise/">entreprise</a>.
    </p>
  </div>
</Base>

<style>
  .ouverture {
    background: var(--pin);
    color: var(--papier);
    padding-block: var(--s-7);
  }
  .ouverture-grille {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: center;
  }
  .ouverture h1 {
    font-size: var(--t-4);
    max-width: 18ch;
  }
  .ouverture-entite {
    margin-top: var(--s-5);
    max-width: 50ch;
    font-size: var(--t-1);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.88);
  }
  .ouverture-appel {
    margin-top: var(--s-6);
  }
  .numero-bloc {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .numero {
    display: inline-block;
    font-family: var(--f-titre);
    font-stretch: var(--large-chiffre);
    font-weight: 850;
    font-size: var(--t-5);
    line-height: 0.95;
    letter-spacing: 0.005em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-decoration: none;
    color: var(--papier);
  }
  .numero:hover,
  .numero:focus-visible {
    color: #ffffff;
  }
  .numero-trait-svg {
    width: 100%;
    height: 16px;
    margin-top: var(--s-1);
    display: block;
    overflow: visible;
  }
  .numero-bloc:hover .numero-trait-svg path,
  .numero-bloc:focus-within .numero-trait-svg path {
    stroke-width: 9;
    filter: drop-shadow(0 0 6px rgba(255, 46, 126, 0.45));
    transition: stroke-width 0.2s ease, filter 0.2s ease;
  }
  .ouverture-actions {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
  }
  .ouverture-actions .btn-secondaire {
    border-color: rgba(255, 255, 255, 0.7);
    color: #ffffff;
    background: transparent;
  }
  .ouverture-actions .btn-secondaire:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }
  .ouverture-actions .btn-tertiaire {
    color: rgba(255, 255, 255, 0.9);
  }
  .ouverture-actions .btn-tertiaire:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }
  .ouverture :global(.ouverture-photo) {
    background: transparent;
  }
  .ouverture :global(.ouverture-photo img) {
    object-position: center 35%;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.3);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .ouverture :global(.ouverture-photo figcaption) {
    color: rgb(255 255 255 / 0.85);
  }

  .deroule {
    border-block: 1px solid var(--filet);
  }
  .etapes {
    list-style: none;
    padding: 0;
    counter-reset: etape;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--s-6);
  }
  .etapes li {
    counter-increment: etape;
    border-top: 2px solid var(--pin);
    padding-top: var(--s-4);
  }
  .etapes li::before {
    content: counter(etape);
    display: block;
    font-family: var(--f-titre);
    font-stretch: var(--large-chiffre);
    font-weight: 850;
    font-size: var(--t-4);
    line-height: 1;
    margin-bottom: var(--s-3);
  }
  .etapes h3 {
    font-size: var(--t-1);
    font-stretch: 82%;
    margin-bottom: var(--s-2);
  }
  .etapes p {
    color: var(--texte-doux);
    font-size: var(--t--1);
    line-height: 1.6;
  }

  .zone-grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--s-7);
    align-items: start;
  }

  .guides {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-6);
  }
  .guides li {
    border-top: 2px solid var(--pin);
    padding-top: var(--s-4);
  }
  .guides h3 {
    font-size: var(--t-2);
    margin-bottom: var(--s-3);
  }
  .guides h3 a {
    text-decoration: none;
  }
  .guides h3 a:hover {
    text-decoration: underline;
  }
  .guides p {
    font-size: var(--t--1);
    color: var(--texte-doux);
  }
  .guides-tous {
    margin-top: var(--s-6);
    font-family: var(--f-titre);
    font-weight: 700;
  }

  .faq-accueil :global(.faq) {
    max-width: var(--mesure);
  }
  .faq-lien-legal {
    max-width: var(--mesure);
    margin-top: var(--s-5);
    font-size: var(--t--1);
    color: var(--texte-doux);
  }
  .faq-lien-legal a {
    color: var(--pin);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .faq-lien-legal a:hover {
    color: var(--orange-signal);
  }

  .focus-nettoyage {
    margin-top: var(--s-7);
    padding: var(--s-6);
    background: var(--fond-doux);
    border: 1px solid var(--filet);
    border-radius: var(--rayon);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: center;
  }
  .focus-badge {
    display: inline-block;
    font-family: var(--f-titre);
    font-stretch: 80%;
    font-weight: 700;
    font-size: var(--t--1);
    background: var(--pin);
    color: #ffffff;
    padding: 0.15rem 0.6rem;
    border-radius: var(--rayon);
    margin-bottom: var(--s-3);
  }
  .focus-nettoyage-texte h3 {
    font-size: var(--t-2);
    font-family: var(--f-titre);
    font-stretch: 74%;
    color: var(--pin-profond);
    margin: 0 0 var(--s-3);
  }
  .focus-nettoyage-texte p {
    color: var(--texte-doux);
    font-size: var(--t-0);
    line-height: 1.55;
    margin: 0 0 var(--s-5);
  }
  .focus-lien {
    display: inline-flex;
    text-decoration: none;
  }
  .focus-nettoyage-photo {
    border-radius: var(--rayon);
    overflow: hidden;
  }

  @media (max-width: 52rem) {
    .ouverture-grille,
    .zone-grille {
      grid-template-columns: 1fr;
    }
    .focus-nettoyage {
      grid-template-columns: 1fr;
      padding: var(--s-4);
      gap: var(--s-4);
    }
    .ouverture {
      padding-block: var(--s-6);
    }
    .ouverture-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .ouverture-actions .action {
      width: 100%;
      justify-content: center;
    }
    .ouverture :global(.ouverture-photo:has(.photo-attente)) {
      display: none;
    }
  }
</style>
