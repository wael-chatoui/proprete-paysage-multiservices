---
import Base from '../../layouts/Base.astro';
import Bandeau from '../../components/Bandeau.astro';
import { guides, dateFr } from '../../lib/contenu';
import { url } from '../../lib/schema';

const liste = await guides();
const miettes = [{ nom: 'Guides', chemin: '/guides/' }];
const noeudListe = {
  '@type': 'ItemList',
  name: 'Guides pratiques',
  itemListElement: liste.map((g, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@id': `${url(`/guides/${g.id}/`)}#article` } })),
};
---
<Base
  titre="Guides : arbres, débroussaillement, voisinage (Landes)"
  description="Débroussaillement obligatoire, branches du voisin, période d'élagage, lignes électriques, tempêtes : guides pratiques sourcés sur les textes officiels."
  og="guides"
  miettes={miettes}
  typePage="CollectionPage"
  noeuds={[noeudListe]}
>
  <Bandeau
    h1="Guides pratiques et réglementation"
    accroche="Les règles qui s'appliquent avant de couper, d'élaguer ou de débroussailler dans les Landes et les départements voisins, avec les textes officiels en source."
    miettes={miettes}
  />
  <div class="enveloppe bloc">
    <ul class="liste-guides">
      {liste.map((g) => (
        <li>
          <h2><a href={`/guides/${g.id}/`}>{g.data.h1}</a></h2>
          <p>{g.data.resume}</p>
          <p class="liste-guides-date">Mis à jour le <time datetime={g.data.dateModified}>{dateFr(g.data.dateModified)}</time>, {g.data.sources.length} sources officielles</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .liste-guides {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--pin);
    max-width: 52rem;
  }
  .liste-guides li {
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--filet);
  }
  .liste-guides h2 {
    font-size: var(--t-3);
  }
  .liste-guides h2 a {
    text-decoration: none;
  }
  .liste-guides h2 a:hover {
    text-decoration: underline;
  }
  .liste-guides p {
    margin-top: var(--s-3);
    max-width: var(--mesure);
  }
  .liste-guides-date {
    font-size: var(--t--1);
    color: var(--texte-doux);
  }
</style>
