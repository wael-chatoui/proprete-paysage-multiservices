---
import Base from '../layouts/Base.astro';
import Bandeau from '../components/Bandeau.astro';
import FicheEntreprise from '../components/FicheEntreprise.astro';
import { business, adresseLigne, siretAffiche } from '../data/business';
import { existsSync } from 'node:fs';
import { photos } from '../data/photos';

const miettes = [{ nom: 'Mentions légales', chemin: '/mentions-legales/' }];
const AC = '[à compléter]';
const exploitant = business.exploitant ?? AC;
const h = business.hebergeur;
const present = (cle: string, p: { fichier?: string }) =>
  (p.fichier ? [p.fichier] : ['jpg', 'jpeg', 'webp', 'png', 'avif'].map((e) => `${cle}.${e}`)).some((f) => existsSync(`src/assets/photos/${f}`));
const credits = Object.entries(photos).filter(([cle, p]) => p.type !== 'reel' && present(cle, p)).map(([, p]) => p);
---
<Base
  titre="Mentions légales"
  description="Mentions légales du site de Propreté Paysage Multiservice, entreprise individuelle à Louer (Landes) : éditeur, SIRET, hébergeur, crédits des images."
  og="accueil"
  miettes={miettes}
>
  <Bandeau h1="Mentions légales" miettes={miettes} />
  <div class="enveloppe bloc">
    <FicheEntreprise titre="Identité de l'entreprise et informations légales" />
  </div>
  <div class="enveloppe bloc prose">
    <h2>Éditeur du site</h2>
    <p>
      {business.nom}, {business.formeJuridique.toLowerCase()} exploitée par {exploitant}.<br />
      Adresse : {adresseLigne}.<br />
      Téléphone : {business.telephone.affichage}. E-mail : {business.email}.<br />
      SIRET : {siretAffiche}. Immatriculation : {business.rcs}.
    </p>

    <h2>Directeur de la publication</h2>
    <p>{exploitant}.</p>

    <h2>Hébergement</h2>
    <p>{h ? `${h.nom}, ${h.adresse}, ${h.telephone}.` : AC}</p>

    <h2>Contenus</h2>
    <p>Les guides résument des textes officiels à la date indiquée sur chaque page et citent leurs sources. Ils ne remplacent pas un conseil juridique. Les textes et la mise en page du site appartiennent à {business.nom}.</p>

    <h2>Images</h2>
    <p>Les images marquées « Illustration » ne montrent pas des chantiers de l'entreprise : ce sont des photos libres de droits ou des images générées par intelligence artificielle, en attendant des photos réelles.</p>
    {credits.length > 0 && (
      <ul>
        {credits.map((p) => (
          <li>{p.alt} : {p.credit ?? 'image générée par IA'}{p.licence && <>, licence <a href={p.licence.url} rel="license noopener">{p.licence.nom}</a></>}{p.source && <>, <a href={p.source} rel="noopener">source</a></>}.</li>
        ))}
      </ul>
    )}
    <p>La carte de la zone d'intervention est un dessin original ; le trait de côte et le cours de l'Adour y sont simplifiés.</p>
  </div>
</Base>
