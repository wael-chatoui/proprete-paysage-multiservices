---
import Base from '../../layouts/Base.astro';
import Bandeau from '../../components/Bandeau.astro';
import ListePrestations from '../../components/ListePrestations.astro';
import EncartContact from '../../components/EncartContact.astro';
import { prestations } from '../../lib/contenu';
import { ID } from '../../lib/schema';

const liste = await prestations();
const miettes = [{ nom: 'Prestations', chemin: '/prestations/' }];
const noeudListe = {
  '@type': 'ItemList',
  name: 'Prestations de Propreté Paysage Multiservice',
  itemListElement: liste.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@id': ID.service(p.id) } })),
};
---
<Base
  titre="Prestations : travaux d'arbres et nettoyage de terrains"
  description="Abattage, élagage, débroussaillage OLD et nettoyage de terrains à Louer et dans les Landes : les prestations de Propreté Paysage Multiservice."
  og="prestations"
  miettes={miettes}
  typePage="CollectionPage"
  noeuds={[noeudListe]}
>
  <Bandeau
    h1="Travaux d'arbres, forêt et nettoyage de terrains dans les Landes"
    accroche="Deux volets d'activité : 4 métiers du bois et de la forêt (abattage, élagage, débardage, débroussaillage) et 2 métiers de propreté extérieure (nettoyage de terrains, entretien de jardins)."
    miettes={miettes}
  />
  <div class="enveloppe page-grille">
    <ListePrestations prestations={liste} poleNiveau="h2" titreNiveau="h3" poles={true} />
    <div class="page-cote"><div class="page-cote-collant"><EncartContact /></div></div>
  </div>
</Base>
