---
import Base from '../../layouts/Base.astro';
import Bandeau from '../../components/Bandeau.astro';
import ListePrestations from '../../components/ListePrestations.astro';
import EncartContact from '../../components/EncartContact.astro';
import { prestations } from '../../lib/contenu';
import { ID } from '../../lib/schema';

const liste = await prestations();
const miettes = [{ nom: 'Prestations', chemin: '/prestations/' }];
const noeudListe = {
  '@type': 'ItemList',
  name: 'Prestations de Propreté Paysage Multiservice',
  itemListElement: liste.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@id': ID.service(p.id) } })),
};
---
<Base
  titre="Prestations : abattage, élagage, débardage dans les Landes"
  description="Abattage, élagage, débardage, débroussaillage et OLD, entretien de jardins, nettoyage de terrains : les prestations de Propreté Paysage Multiservice à Louer."
  og="prestations"
  miettes={miettes}
  typePage="CollectionPage"
  noeuds={[noeudListe]}
>
  <Bandeau
    h1="Nos prestations de travaux forestiers et d'entretien extérieur"
    accroche="Six prestations, de l'arbre isolé au fond du jardin à la parcelle forestière, dans les Landes et les départements voisins."
    miettes={miettes}
  />
  <div class="enveloppe page-grille">
    <ListePrestations prestations={liste} titreNiveau="h2" />
    <div class="page-cote"><div class="page-cote-collant"><EncartContact /></div></div>
  </div>
</Base>
